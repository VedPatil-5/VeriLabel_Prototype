def calculate_need(need, max_matrix, allocation, n, m):
    for i in range(n):
        for j in range(m):
            need[i][j] = max_matrix[i][j] - allocation[i][j]

def is_safe(processes, available, max_matrix, allocation, n, m):
    need = [[0] * m for _ in range(n)]
    calculate_need(need, max_matrix, allocation, n, m)
    work = available.copy()
    finish = [False] * n
    safe_sequence = []
    count = 0
    while count < n:
        found = False
        for i in range(n):
            if not finish[i]:
                if all(need[i][j] <= work[j] for j in range(m)):
                    for j in range(m):
                        work[j] += allocation[i][j]
                    finish[i] = True
                    safe_sequence.append(i)
                    found = True
                    count += 1
        if not found:
            print("\nSystem is NOT in a safe state. Deadlock possible!")
            return False, []
    print("\nSystem is in a SAFE state.")
    print("Safe Sequence:", " -> ".join(f"P{p}" for p in safe_sequence))
    return True, safe_sequence

def print_matrix(name, matrix):
    print(f"\n{name}:")
    for row in matrix:
        print(row)

def main():
    n = 5
    m = 3
    available = [3, 3, 2]
    max_matrix = [
        [7, 5, 3],
        [3, 2, 2],
        [9, 0, 2],
        [2, 2, 2],
        [4, 3, 3]
    ]
    allocation = [
        [0, 1, 0],
        [2, 0, 0],
        [3, 0, 2],
        [2, 1, 1],
        [0, 0, 2]
    ]
    processes = [f"P{i}" for i in range(n)]
    print("Number of processes:", n)
    print("Number of resources:", m)
    print("Available Resources:", available)
    print_matrix("Maximum Matrix", max_matrix)
    print_matrix("Allocation Matrix", allocation)
    is_safe(processes, available, max_matrix, allocation, n, m)

if __name__ == "__main__":
    main()